<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ff_pos_advanced_discounts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='pos_global_discount']" position="after">
                <setting id="ff_advanced_discounts" string="Advanced Discounts"
                         help="Allow percentage and fixed discounts per line and per order.">
                    <field name="pos_ff_advanced_discount_enabled"/>
                    <div class="content-group mt16" invisible="not pos_ff_advanced_discount_enabled">
                        <div class="row mt16">
                            <label for="pos_ff_discount_max_percentage" string="Maximum percentage" class="col-lg-6 o_light_label"/>
                            <field name="pos_ff_discount_max_percentage"/>
                        </div>
                        <div class="row mt16">
                            <label for="pos_ff_discount_max_amount" string="Maximum fixed amount" class="col-lg-6 o_light_label"/>
                            <field name="pos_ff_discount_max_amount"/>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
